  function handlePlay() {
    playTrack(track, playlist);
  }

  async function handleShare() {
    const cardUrl = getCardUrl(card.id);
    await Share.share({ message: cardUrl, url: cardUrl });
  }

  function handleCardPress() {
    router.push(`/audio/${card.id}` as any);
