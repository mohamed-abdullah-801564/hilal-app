  getDoc,
  setDoc,
  onSnapshot,
  query,
  orderBy,
  where,
  serverTimestamp,
  Timestamp,
  arrayUnion,
  arrayRemove,
  type Unsubscribe,
} from "firebase/firestore";
import { db } from "./firebase.config";

// ─── Types ────────────────────────────────────────────────────────────────────

export interface FBCategory {
  id:           string;
  name:         string;
  nameEn:       string;
  icon:         string;
  color:        string;
  description:  string;
  sortOrder:    number;
  createdAt:    number;
