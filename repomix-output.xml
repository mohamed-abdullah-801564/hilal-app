          {!!(card.titleTa && card.titleEn) && (
            <Text style={[styles.cardTitleEn, { color: sub }]} numberOfLines={1}>
              {card.titleEn}
            </Text>
          )}
        </View>
        <Pressable
          onPress={() => { fav ? removeFavorite(card.id) : addFavorite(card.id); }}
