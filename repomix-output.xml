  const sub = isDark ? "#888"    : "#5a7a64";

  useEffect(() => {
    if (!id) { setLoading(false); return; }
    getCardById(id)
      .then(c => { setCard(c); })
      .catch(() => {})
      .finally(() => setLoading(false));
  }, [id]);

  const topPad = Platform.OS === "web" ? 67 : insets.top;

  if (loading) {
    return (
      <View style={[styles.root, { backgroundColor: bg, paddingTop: topPad + 20 }]}>
