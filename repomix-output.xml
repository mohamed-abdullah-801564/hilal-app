  console.log("[Seeder] ── createHadithCards() started ──────────────────────");

  // ── Step 1: Find category where nameEn = "Hadith" ─────────────────────────
  console.log('[Seeder] Step 1: Looking for category nameEn = "Hadith"...');

  const catSnap = await getDocs(
