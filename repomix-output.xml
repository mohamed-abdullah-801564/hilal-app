        </Text>
      </View>
    );
  }

  const kind = slideKindFromUrl(src);
  // TEMP DEBUG LOG — remove after root cause is confirmed
  console.log("[SlideTab][DEBUG] detected kind =", kind);

  if (kind === "ppt") {
    return <PptNotice isDark={isDark} />;
  }

  if (kind === "image") {
